# ---------------------------------------------------------------------------
# Agentic Systems Foundations — environment configuration (copy to `.env`)
# ---------------------------------------------------------------------------
# The agent is PROVIDER-AGNOSTIC. You change providers by editing the variables
# below — no code changes. With NO key at all, everything falls back to a
# deterministic offline "mock" that still DECIDES TOOL CALLS, so the full agent
# loop runs in a keyless classroom.
# ---------------------------------------------------------------------------

# --- LLM provider: openai | mock -------------------------------------------
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4o-mini

# --- API key (only needed for the matching provider) ------------------------
OPENAI_API_KEY=sk-...your-key-here...

# --- Loop safety rails ------------------------------------------------------
# These are DEFAULTS for AgentState's budget. An agent without limits is a
# billing incident waiting to happen — see notebook 05.
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12

# --- Tracing ----------------------------------------------------------------
# verbose | quiet — verbose prints each step as it happens (good for teaching).
AGENT_TRACE_MODE=verbose
